# Port for the Express API
PORT=5005
# Optional: Google AI Studio key. When set, /api/analyze adds an LLM summary.
GEMINI_API_KEY=
# Optional: Gemini model id (default: gemini-flash-latest)
GEMINI_MODEL=
# Optional: comma-separated allowed origins (default: allow all)
CORS_ORIGIN=
# Optional: max upload size in MB (default: 10)
MAX_UPLOAD_MB=10
